# --- Database (MySQL 8.x, utf8mb4) ---
DATABASE_URL=mysql+pymysql://catchap_user:catchap_pass_2026@localhost:3306/catchap?charset=utf8mb4

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Gmail SMTP (비우면 콘솔 dry-run 모드) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=CatChap
MAIL_REPLY_TO=

# --- Course payments ---
# 개발에서만 mock 허용. ENV=production이면 true여도 서버가 mock을 비활성화한다.
PAYMENT_MOCK_ENABLED=true
# 토스페이먼츠: client key만 브라우저 공개 가능, secret key는 백엔드 전용.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 카카오페이 온라인 결제: CID/Secret key 모두 백엔드 전용.
KAKAOPAY_CID=
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID_SECRET=
# 포트원(PortOne) V2 — 콘솔 결제연동>채널관리에서 채널을 만들면 채널 키가 나온다.
# store id·channel key는 브라우저 SDK가 쓰는 공개값, API Secret은 서버 전용이다.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
# 비우면 FRONTEND_URL/student/payment/{success|fail|cancel}
PAYMENT_SUCCESS_URL=
PAYMENT_FAIL_URL=
PAYMENT_CANCEL_URL=

# --- 소셜 로그인 (카카오 / 네이버 / 구글) ---
# 비우면 그 provider는 비활성(프론트 버튼 미노출 + 호출 시 503). 학생 계정 전용이다.
# 콘솔에 등록하는 Redirect URI는 아래 SOCIAL_REDIRECT_URIS 값과 반드시 같아야 한다.
#   카카오  https://developers.kakao.com  내 애플리케이션 > 카카오 로그인 > Redirect URI
#           (client_secret은 '보안' 탭에서 사용함으로 켠 경우에만 필요)
#   네이버  https://developers.naver.com  애플리케이션 등록 > 서비스 URL / Callback URL
#   구글    https://console.cloud.google.com  API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 쉼표로 여러 개(로컬·스테이징·운영). 비우면 FRONTEND_URL/auth/social/callback 만 허용.
SOCIAL_REDIRECT_URIS=http://localhost:5173/auth/social/callback
# 카카오 동의항목 — 콘솔에서 '사용 안 함/권한 없음'인 항목을 요청하면 로그인이 거절된다(KOE205).
# 이메일(account_email)은 비즈 앱 전환 후에만 열리므로 기본값은 닉네임만이다.
# 열고 나면: KAKAO_SCOPES=profile_nickname account_email
KAKAO_SCOPES=profile_nickname

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Misc ---
ENV=dev
