# CatChap 백엔드 프로덕션 환경변수 — 백엔드 VM(210.109.52.124)에서 .env.production 으로 복사 후 값 채우기.
# compose가 env_file로 컨테이너에 주입한다. 이 파일(예시)만 git에 두고, 실제 값 파일은 커밋 금지.

# --- Database ---
# 백엔드↔DB는 같은 사설망(10.0.1.x) → 사설 IP 사용, DB VM의 공인 3306은 닫는다.
# 비밀번호의 @ 등 특수문자는 URL 인코딩(@→%40).
DATABASE_URL=mysql+pymysql://catchap_backend:<DB_PW_URLENCODED>@10.0.1.168:3306/catchap_dev_db?charset=utf8mb4

# --- 환경(프로덕션 강제) ---
# production 이면 /docs 비공개 + 부팅 시 시크릿/CORS/SMTP 검증. 반드시 production.
ENV=production

# --- JWT (프로덕션 신규 생성! 개발 PC 시크릿 재사용 금지) ---
# 생성 예: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=__여기에_새로_생성한_64자_hex__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- URL / CORS (도메인 기준, https) ---
FRONTEND_URL=https://www.catchap5.com
BACKEND_URL=https://api.catchap5.com
CORS_ORIGINS=https://www.catchap5.com,https://catchap5.com

# --- 리버스 프록시(Caddy) 뒤에 있으므로 XFF 신뢰 ---
TRUST_PROXY_HEADER=true

# --- SMTP (발신 도메인=서비스 도메인으로 정렬 권장) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=__워크스페이스_계정__
SMTP_APP_PASSWORD=__앱_비밀번호__
MAIL_FROM=catchap5@catchap5.com
MAIL_FROM_NAME=CatChap
MAIL_REPLY_TO=no-reply@catchap5.com
